NEXTAUTH_SECRET=my-superstrong-secret
NEXTAUTH_URL=http://localhost:3000

NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000

NEXT_PUBLIC_APP_BASE_HOST=localhost

# These variables are from Vercel Storage Postgres
POSTGRES_PRISMA_URL=
POSTGRES_PRISMA_URL_NON_POOLING=
# [fork] Where logos, preview images and visit exports go (build-time):
# "s3" (default) uses NEXT_PRIVATE_UPLOAD_PUBLIC_BUCKET below; "vercel" uses
# Vercel Blob with BLOB_READ_WRITE_TOKEN.
BLOB_BACKEND=s3
# This variable is from Vercel Storage Blob (BLOB_BACKEND=vercel only)
BLOB_READ_WRITE_TOKEN=

# Google client id and secret for authentication
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# This variable is from Resend to send emails
RESEND_API_KEY=

# This variable is from Tinybird to publish and read event data
TINYBIRD_TOKEN=

# These variables are from Vercel and used for setting up custom domains
PROJECT_ID_VERCEL=
TEAM_ID_VERCEL=
AUTH_BEARER_TOKEN=

# Upstash QStash – required for queues and background jobs
# Get your QStash Token here: https://upstash.com/docs/qstash/overall/getstarted
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# [fork] Passkeys run on SimpleWebAuthn (oss/passkeys); no Hanko keys needed.
# They need https with a certificate the device trusts (or localhost).
# PASSKEY_LOGIN=false hides the login button; PASSKEY_RP_NAME is the name devices show (blank = Papermark)
PASSKEY_LOGIN=
PASSKEY_RP_NAME=

# Trigger v3
TRIGGER_SECRET_KEY=
TRIGGER_API_URL=https://api.trigger.dev

# [[STORAGE]]
# Defines the storage transport to use. Available options: vercel (default) | s3
NEXT_PUBLIC_UPLOAD_TRANSPORT="vercel"
# REQUIRED: Defines the distribution host (without protocol) to use for the storage transport. Either cloudfront, s3, or vercel blob host. Used in next.config.mjs configuration.
NEXT_PRIVATE_UPLOAD_DISTRIBUTION_HOST="<BLOB_STORE_ID>.public.blob.vercel-storage.com" | "<DISTRIBUTION_ID>.cloudfront.net" | "<BUCKET_NAME>.s3.<REGION>.amazonaws.com"
# OPTIONAL: Defines the endpoint to use for the S3 storage transport. Relevant when using third-party S3-compatible providers.
NEXT_PRIVATE_UPLOAD_ENDPOINT=""
# Defines the region to use for the S3 storage transport. Defaults to us-east-1.
NEXT_PRIVATE_UPLOAD_REGION="us-east-1"
# REQUIRED: Defines the bucket to use for the S3 storage transport.
NEXT_PRIVATE_UPLOAD_BUCKET="YOUR_BUCKET_NAME"
# [fork] BLOB_BACKEND=s3: a second bucket with anonymous read for public files
# (logos, link preview images, visit exports). Same credentials as above.
NEXT_PRIVATE_UPLOAD_PUBLIC_BUCKET="YOUR_PUBLIC_BUCKET_NAME"
# [fork] Optional: base URL public objects are served from. Default: derived
# from NEXT_PRIVATE_UPLOAD_ENDPOINT (path style: <endpoint>/<bucket>).
NEXT_PRIVATE_UPLOAD_PUBLIC_BASE_URL=
# REQUIRED: Defines the access key ID to use for the S3 storage transport.
NEXT_PRIVATE_UPLOAD_ACCESS_KEY_ID=""
# REQUIRED: Defines the secret access key to use for the S3 storage transport.
NEXT_PRIVATE_UPLOAD_SECRET_ACCESS_KEY=""
# Defines the Cloudfront distribution domain to use for the S3 storage transport. Relevant when using Cloudfront.
NEXT_PRIVATE_UPLOAD_DISTRIBUTION_DOMAIN=""
# Defines the public key ID to sign Cloudfront URLs. Relevant when using Cloudfront.
NEXT_PRIVATE_UPLOAD_DISTRIBUTION_KEY_ID=""
# Defines the private key contents to sign Cloudfront URLs. Relevant when using Cloudfront. Should be a PEM-encoded RSA 2048 private key.
NEXT_PRIVATE_UPLOAD_DISTRIBUTION_KEY_CONTENTS=
# [fork] Use path-style S3 URLs (endpoint/bucket/key). Set to true for MinIO/Garage without wildcard DNS.
NEXT_PRIVATE_UPLOAD_FORCE_PATH_STYLE=
# [fork] OPTIONAL: second bucket used for advanced Excel viewing.
NEXT_PRIVATE_ADVANCED_UPLOAD_BUCKET=
# [fork] OPTIONAL: AWS Lambda for bulk ZIP downloads (AWS only).
NEXT_PRIVATE_DOWNLOAD_LAMBDA_FUNCTION_NAME=
# [fork] REQUIRED for Office/Keynote uploads: Gotenberg (LibreOffice) URL, e.g. http://gotenberg:3000
GOTENBERG_URL=
# [fork] Self-hosted Trigger.dev: point TRIGGER_API_URL (above) at your instance, e.g. http://localhost:8030,
# and set its project ref (proj_...). Empty keeps upstream's cloud project.
TRIGGER_PROJECT_REF=
# [fork] Email over SMTP (replaces Resend when SMTP_HOST is set). Papermark's own
# campaign mails (marketing / scheduled) are skipped in SMTP mode.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465); STARTTLS on 587 is negotiated automatically
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Sender for all mail, e.g. "Mi Casa Docs <docs@example.com>" (quote it)
EMAIL_FROM=
EMAIL_REPLY_TO=

# Encryption key for document passwords. 
NEXT_PRIVATE_DOCUMENT_PASSWORD_KEY=my-superstrong-document-secret

# [[REDIS LOCKER CONFIGURATION]]
# For bulk upload using tus.io, we use a Redis-based locker to prevent corruption of the data.
UPSTASH_REDIS_REST_LOCKER_URL=
UPSTASH_REDIS_REST_LOCKER_TOKEN=

# [[UNSUBSCRIBE / INVITATION LINKS]]
# Signs the unsubscribe links in notification emails and team invitation links
NEXT_PRIVATE_UNSUBSCRIBE_JWT_SECRET=

# [[VERIFICATION]]
# Secret used to generate the checksum for the verification URL
NEXT_PRIVATE_VERIFICATION_SECRET=

# [[INCOMING WEBHOOKS]]
NEXT_PUBLIC_WEBHOOK_BASE_URL=
NEXT_PUBLIC_WEBHOOK_BASE_HOST=

# [[JOBS (DBOS)]]
# Background jobs backend, chosen at build time: "dbos" (default) or "trigger"
JOBS_BACKEND=dbos
# Max concurrent runs per jobs worker (positive integer)
JOBS_WORKER_CONCURRENCY=4
# Postgres pool size for the jobs layer (positive integer; blank = 3 per app
# process, JOBS_WORKER_CONCURRENCY + 4 in the worker)
JOBS_DB_POOL_SIZE=
# How long a stopping jobs worker waits for executing runs (blank = 30000 ms)
JOBS_SHUTDOWN_TIMEOUT_MS=
# [fork] Beta flags for every team when EDGE_CONFIG is unset (comma-separated). Useful for a self-host: tokens, incomingWebhooks, webhooks, dataroomUpload, annotations, textSelection
FEATURE_FLAGS=
# [fork] Company named in email footers ("© <year> <name>. All rights reserved.") and its one-line postal address; blank = left out
EMAIL_COMPANY_NAME=
EMAIL_COMPANY_ADDRESS=
# [fork] Outgoing webhooks are delivered by the jobs worker when QSTASH_TOKEN is unset; endpoints on private/loopback addresses are refused unless this is true
WEBHOOK_ALLOW_PRIVATE_URLS=
